{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouLoad",
  "version": "1.0.2",
  "identifier": "app.youload.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YouLoad",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#16171b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https://i.ytimg.com https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "YouLoad contributors",
    "copyright": "MIT License",
    "category": "Video",
    "shortDescription": "YouTube downloader",
    "resources": {
      "resources/tools/": "tools/",
      "resources/app/": "app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQTAwRjJGRTZENDJCNDUKUldSRks5VG1MdytnOG9WK1BMR2JCTjNpaFVackhrRkVaVWZHMW12RGVDdXA4cGtYQW50OVhKTUkK",
      "endpoints": [
        "https://github.com/Liidioteee/YouLoad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
